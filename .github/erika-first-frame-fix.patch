@@ -4856,21 +4856,58 @@ unsafe extern "C" fn custom_avio_seek(opaque: *mut c_void, offset: i64, whence:
     unsafe { (&mut *(opaque.cast::<CustomAvio>())).seek(offset, whence) }
 }
 
+/// Probe-stage AVOptions for `avformat_open_input`: `probesize` and
+/// `analyzeduration` can be overridden through `ERIKA_PROBESIZE` /
+/// `ERIKA_ANALYZEDURATION` (microseconds). Both stay at FFmpeg's defaults when
+/// unset, so local playback is unchanged; hosts with slow network sources can
+/// bound how much data the synchronous open reads before Ready.
+fn probe_options() -> *mut sys::AVDictionary {
+    let mut options: *mut sys::AVDictionary = ptr::null_mut();
+    for (name, variable) in [
+        (c"probesize", "ERIKA_PROBESIZE"),
+        (c"analyzeduration", "ERIKA_ANALYZEDURATION"),
+    ] {
+        let Ok(value) = std::env::var(variable) else {
+            continue;
+        };
+        if value.is_empty() {
+            continue;
+        }
+        let Ok(value) = CString::new(value) else {
+            continue;
+        };
+        unsafe {
+            sys::av_dict_set(&mut options, name.as_ptr(), value.as_ptr(), 0);
+        }
+    }
+    options
+}
+
+fn free_probe_options(mut options: *mut sys::AVDictionary) {
+    if !options.is_null() {
+        unsafe { sys::av_dict_free(&mut options) };
+    }
+}
+
 fn open_format_context(uri: &str) -> Result<FormatContext> {
     install_ffmpeg_log_capture();
     let input = CString::new(uri).map_err(|_| FfmpegError::InteriorNul)?;
     let mut format_context = ptr::null_mut();
-    check(
+    let mut options = probe_options();
+    let opened = check(
         unsafe {
             sys::avformat_open_input(
                 &mut format_context,
                 input.as_ptr(),
                 ptr::null_mut(),
-                ptr::null_mut(),
+                &mut options,
             )
         },
         "avformat_open_input",
-    )?;
+    );
+    // Entries the demuxer did not consume are still owned by the dictionary.
+    free_probe_options(options);
+    opened?;
     FormatContext::new(format_context)
 }
 
